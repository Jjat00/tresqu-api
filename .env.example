# ===========================================
# Tresqu API - Variables de Entorno
# ===========================================
# Copia este archivo como .env y completa los valores

# --- Base de datos ---
DATABASE_URL=postgresql://cashbot:cashbot@db:5432/cashbot
DEBUG=True

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_BOT_USERNAME=

# --- Meta WhatsApp API ---
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=mi_token_secreto
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_BOT_NUMBER=

# --- Gmail Integration (via Composio) ---
# El OAuth de Gmail y el polling se delegan a Composio (composio.dev).
# Crea un auth config Gmail en el dashboard y un webhook subscription
# apuntando a {backend}/api/integrations/gmail/composio-webhook/.
COMPOSIO_API_KEY=ak_...
COMPOSIO_WEBHOOK_SECRET=
COMPOSIO_GMAIL_AUTH_CONFIG_ID=ac_...

# --- Celery / Redis ---
# Dev en host (runserver): apunta a localhost:6379. El worker dockerizado
# usa el hostname interno `redis:6379` (hardcoded en docker-compose.dev.yml).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Wallbit ---
# Clave maestra para cifrar las API keys de Wallbit que dan los usuarios.
# No la cambies en prod una vez tengas cuentas conectadas.
WALLBIT_ENCRYPTION_KEY=

# --- Market data (Analista de mercado) ---
# Wallbit no expone precios históricos; usamos Twelve Data (free ~800 req/día).
# Obtén la key en https://twelvedata.com/. Sin ella, el histórico no funciona
# pero el resto del sistema sigue operando.
TWELVE_DATA_API_KEY=
# Cache dedicado para histórico de precios (Redis db 2). En dev en host usa
# localhost; el worker dockerizado resuelve `redis` por la red de compose.
MARKETDATA_CACHE_URL=redis://localhost:6379/2

# --- Frontend ---
# Se usa para redirigir al usuario tras el callback OAuth de Composio.
FRONTEND_URL=http://localhost:5173

# --- Supabase (produccion) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ---
ADMIN_API_KEY=admin_secret_key

# --- Planes ---
BASIC_PLAN_MAX_EXPENSES=50
BASIC_PLAN_MAX_INCOMES=50
