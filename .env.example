# ===========================================
# Tresqu API - Variables de Entorno
# ===========================================
# Copia este archivo como .env y completa los valores

# --- Base de datos ---
DATABASE_URL=postgresql://cashbot:cashbot@db:5432/cashbot
DEBUG=True

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_BOT_USERNAME=

# --- Meta WhatsApp API ---
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=mi_token_secreto
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_BOT_NUMBER=

# --- Google Gmail Integration ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback/
GOOGLE_PUBSUB_TOPIC=projects/tu-project-id/topics/gmail-notifications
GOOGLE_CLOUD_PROJECT_ID=
GMAIL_TOKEN_ENCRYPTION_KEY=
# Generar con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Supabase (produccion) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ---
ADMIN_API_KEY=admin_secret_key

# --- Planes ---
BASIC_PLAN_MAX_EXPENSES=50
BASIC_PLAN_MAX_INCOMES=50
